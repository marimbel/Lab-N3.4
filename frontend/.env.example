# Which backend the frontend calls: Y = Google Cloud Run, AWS = AWS Elastic Beanstalk, N = local,
# SAME = the server that served the page (use when building the frontend into backend/public for Elastic Beanstalk)
VITE_SERVER_REMOTE=AWS
VITE_SERVER_URL_REMOTE=https://your-cloud-run-backend-url
VITE_SERVER_URL_AWS=http://your-env.us-west-2.elasticbeanstalk.com
VITE_SERVER_URL_LOCAL=http://localhost:3001
